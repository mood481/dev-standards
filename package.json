{
  "name": "@mood481/dev-standards",
  "version": "0.2.0-beta.1",
  "description": "Versioned development rules and implementation guides for mood481 repositories.",
  "type": "module",
  "bin": {
    "dev-standards": "bin/dev-standards.mjs"
  },
  "files": [
    "bin/**",
    "catalog.json",
    "rules/**",
    "guides/**",
    "adrs/**",
    "runbooks/**",
    "references/**",
    "schemas/**",
    "templates/**",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "release:plan": "node tools/release-plan.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
