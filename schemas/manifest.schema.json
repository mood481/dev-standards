{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mood481:dev-standards:manifest:v1",
  "title": "Development standards manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "context"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "version"
      ],
      "properties": {
        "repository": {
          "const": "mood481/dev-standards"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "context": {
      "type": "array",
      "uniqueItems": true,
      "description": "Repository-relative context entries. Each type/id pair and each path must be unique.",
      "items": {
        "$ref": "#/$defs/contextEntry"
      }
    }
  },
  "$defs": {
    "contextEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "path"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "description": "Semantic context type. rule, guide and operation are currently registered; other descriptive types are allowed."
        },
        "id": {
          "type": "string",
          "pattern": "^[^/\\\\\\u0000-\\u001F]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*//)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*\\\\)[^\\u0000-\\u001F]+$"
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "rule"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "integrity"
            ],
            "properties": {
              "path": {
                "pattern": "^docs/rules/[^/]+\\.md$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "guide"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "integrity"
            ],
            "properties": {
              "path": {
                "pattern": "^docs/guides/[^/]+\\.md$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "operation"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "^docs/operations/[^/]+\\.md$"
              }
            }
          }
        }
      ]
    }
  }
}
